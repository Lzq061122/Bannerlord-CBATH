<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CombatBrainAutonomousTestHarness</AssemblyName>
    <RootNamespace>CombatBrainAutonomousTestHarness</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BuildIdentity.g.cs" />
    <Compile Include="RuntimeIdentity.cs" />
    <Compile Include="MainThreadDispatcher.cs" />
    <Compile Include="ScreenProbe.cs" />
    <Compile Include="FormationProbe.cs" />
    <Compile Include="MissionControl.cs" />
    <Compile Include="CbathTools.cs" />
    <Compile Include="SamplingMissionBehavior.cs" />
    <Compile Include="RunRecord.cs" />
    <Compile Include="ProbeSubModule.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.4.8.119303" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.CustomBattle" Version="1.4.8.119303" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.GAB" Version="0.1.0" />
  </ItemGroup>

</Project>
